{
    "title": "scrape_logs",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "user_id": {
            "type": "string",
            "description": "User ID"
        },
        "asin": {
            "type": "string",
            "description": "ASIN of the product"
        },
        "marketplace": {
            "type": "string",
            "description": "Marketplace code like US, JP, DE"
        },
        "scrape_method": {
            "type": "string",
            "description": "Method used: cors_proxy, server_scrape, manual_paste, ai_search"
        },
        "success": {
            "type": "boolean",
            "description": "Whether the scrape was successful"
        },
        "data_source": {
            "type": "string",
