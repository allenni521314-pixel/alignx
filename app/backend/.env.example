DATABASE_URL=sqlite+aiosqlite:///sql_app.db

# Qwen / OpenAI-compatible model gateway (DashScope Bailian)
AI_PROVIDER=qwen
AI_API_MODE=chat
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace_with_your_dashscope_key
AI_DEFAULT_MODEL=qwen3-32b
AI_LIGHT_MODEL=qwen3-32b
AI_REASONING_MODEL=qwen3-32b
AI_DEEP_MODEL=qwen3-32b

# COSMO/Rufus semantic foundation (SiliconFlow OpenAI-compatible APIs)
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=replace_with_your_siliconflow_key
AI_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace_with_your_siliconflow_key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace_with_your_siliconflow_key

# Qwen vision model / OpenAI-compatible multimodal endpoint
VISION_PROVIDER=qwen
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=replace_with_your_dashscope_key
AI_VISION_MODEL=qwen2.5-vl-72b-instruct
VISION_REQUEST_TIMEOUT=180
