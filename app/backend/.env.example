DATABASE_URL=sqlite+aiosqlite:///sql_app.db
SUPER_ADMIN_EMAILS=allenni521314@gmail.com

# Model boundary:
# - DeepSeek owns text reasoning, ASIN/Listing diagnosis, Top40 synthesis, and final seller decisions.
# - Qwen Vision owns image/A+/OCR visual evidence only.
# - SiliconFlow BGE-M3 owns semantic memory and similar-history retrieval.
# - SiliconFlow BGE Reranker owns precision filtering of retrieved evidence.
# Full policy: app/backend/rules/model_boundaries.md

# DeepSeek / OpenAI-compatible model gateway
AI_PROVIDER=deepseek
AI_API_MODE=chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace_with_your_deepseek_key
AI_DEFAULT_MODEL=deepseek-v4-flash
AI_LIGHT_MODEL=deepseek-v4-flash
AI_REASONING_MODEL=deepseek-v4-pro
AI_DEEP_MODEL=deepseek-v4-pro

# COSMO/Rufus semantic foundation (SiliconFlow OpenAI-compatible APIs)
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=replace_with_your_siliconflow_key
AI_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace_with_your_siliconflow_key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace_with_your_siliconflow_key

# Qwen vision model / OpenAI-compatible multimodal endpoint
VISION_PROVIDER=qwen
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=replace_with_your_dashscope_key
AI_VISION_MODEL=qwen2.5-vl-72b-instruct
VISION_REQUEST_TIMEOUT=180
