DATABASE_URL=sqlite+aiosqlite:///sql_app.db

# DeepSeek / OpenAI-compatible model gateway
AI_PROVIDER=deepseek
AI_API_MODE=chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace_with_your_local_key
AI_DEFAULT_MODEL=deepseek-chat
AI_LIGHT_MODEL=deepseek-chat
AI_REASONING_MODEL=deepseek-chat
AI_DEEP_MODEL=deepseek-chat

# Qwen vision model / OpenAI-compatible multimodal endpoint
VISION_PROVIDER=qwen
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=replace_with_your_local_vision_key
AI_VISION_MODEL=qwen3-vl-plus
VISION_REQUEST_TIMEOUT=180
