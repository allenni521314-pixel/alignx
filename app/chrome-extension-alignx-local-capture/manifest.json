{
  "manifest_version": 3,
  "name": "AlignX Local Amazon Capture",
  "description": "读取当前用户已打开的 Amazon 商品页，作为 AlignX 本地浏览器页面采集体验版。",
  "version": "0.1.5",
  "action": {
    "default_title": "AlignX Capture",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://alignxagent.netlify.app/*"],
      "js": ["alignx-content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://amazon.com/*",
    "https://*.amazon.com/*",
    "https://www.amazon.com/*",
    "https://amazon.co.uk/*",
    "https://*.amazon.co.uk/*",
    "https://www.amazon.co.uk/*",
    "https://amazon.de/*",
    "https://*.amazon.de/*",
    "https://www.amazon.de/*",
    "https://amazon.co.jp/*",
    "https://*.amazon.co.jp/*",
    "https://www.amazon.co.jp/*",
    "https://amazon.ca/*",
    "https://*.amazon.ca/*",
    "https://www.amazon.ca/*",
    "https://amazon.fr/*",
    "https://*.amazon.fr/*",
    "https://www.amazon.fr/*",
    "https://amazon.it/*",
    "https://*.amazon.it/*",
    "https://www.amazon.it/*",
    "https://amazon.es/*",
    "https://*.amazon.es/*",
    "https://www.amazon.es/*",
    "https://amazon.com.au/*",
    "https://*.amazon.com.au/*",
    "https://www.amazon.com.au/*",
    "https://alignxagent.netlify.app/*"
  ]
}
