DATABASE_URL=sqlite+aiosqlite:///sql_app.db
SUPER_ADMIN_EMAILS=allenni521314@gmail.com

# Model boundary:
# - DeepSeek owns text reasoning, ASIN/Listing diagnosis, Top40 synthesis, and final seller decisions.
# - Qwen Vision owns image/A+/OCR visual evidence only.
# - SiliconFlow BGE-M3 owns semantic memory and similar-history retrieval.
# - SiliconFlow BGE Reranker owns precision filtering of retrieved evidence.
# Full policy: app/backend/rules/model_boundaries.md

# DeepSeek / OpenAI-compatible model gateway
AI_PROVIDER=deepseek
AI_API_MODE=chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace_with_your_deepseek_key
AI_DEFAULT_MODEL=deepseek-v4-flash
AI_LIGHT_MODEL=deepseek-v4-flash
AI_REASONING_MODEL=deepseek-v4-pro
AI_DEEP_MODEL=deepseek-v4-pro
AI_PRICE_DEEPSEEK_V4_FLASH_INPUT_CNY_PER_1M=1.008
AI_PRICE_DEEPSEEK_V4_FLASH_OUTPUT_CNY_PER_1M=2.016
AI_PRICE_DEEPSEEK_V4_PRO_INPUT_CNY_PER_1M=3.132
AI_PRICE_DEEPSEEK_V4_PRO_OUTPUT_CNY_PER_1M=6.264

# COSMO/Rufus semantic foundation (SiliconFlow OpenAI-compatible APIs)
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=replace_with_your_siliconflow_key
PRODUCT_IMAGE_PROVIDER=dashscope
PRODUCT_IMAGE_MODEL=wan2.7-image
PRODUCT_IMAGE_SIZE=1K
PRODUCT_IMAGE_TIMEOUT=180
PRODUCT_IMAGE_DIRECT_AI=true
PRODUCT_IMAGE_DIRECT_AI_ATTEMPTS=3
PRODUCT_IMAGE_USE_AI_BACKGROUND=false
PRODUCT_IMAGE_VISION_QA=true
DOUBAO_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_ENDPOINT=/images/generations
DOUBAO_IMAGE_API_KEY=replace_with_your_volcengine_ark_key
DOUBAO_IMAGE_MODEL=doubao-seedream-4-5-251128
DOUBAO_IMAGE_SIZE=2048x2048
DOUBAO_IMAGE_TIMEOUT=180
OPENAI_IMAGE_API_KEY=replace_with_your_openai_image_key
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_TIMEOUT=180
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_ENDPOINT=/api/v1/services/aigc/multimodal-generation/generation
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
SILICONFLOW_IMAGE_TIMEOUT=180
SILICONFLOW_IMAGE_STEPS=50
SILICONFLOW_IMAGE_CFG=4.0
CANVA_EXTERNAL_ASSET_ENABLED=false
CANVA_API_TOKEN=replace_with_your_canva_token
AI_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace_with_your_siliconflow_key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace_with_your_siliconflow_key

# Qwen vision model / OpenAI-compatible multimodal endpoint
VISION_PROVIDER=qwen
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=replace_with_your_dashscope_key
AI_VISION_MODEL=qwen3-vl-plus
VISION_REQUEST_TIMEOUT=180
AI_PRICE_QWEN2_5_VL_72B_INSTRUCT_INPUT_CNY_PER_1M=16.5168
AI_PRICE_QWEN2_5_VL_72B_INSTRUCT_OUTPUT_CNY_PER_1M=49.5432

# External Amazon capture
AMAZON_CAPTURE_PROVIDER=scraperapi
SCRAPERAPI_KEY=replace_with_your_scraperapi_key
SCRAPERAPI_BASE_URL=https://api.scraperapi.com
SCRAPERAPI_TIMEOUT_SECONDS=300
SCRAPERAPI_PREMIUM=false
SCRAPERAPI_ULTRA_PREMIUM=false
